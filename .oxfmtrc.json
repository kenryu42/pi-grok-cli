{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.css", "*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    }
  ]
}
